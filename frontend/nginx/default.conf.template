# Rendered by the nginx image's envsubst step at container start.
# BACKEND_URL: where /api is proxied (Compose: http://backend:8000, Kubernetes: the backend Service).
# NGINX_LOCAL_RESOLVERS: filled from /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1), so the
# backend name is resolved per request and nginx never fails to start if the backend is not up yet.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri /index.html;
    }
}
