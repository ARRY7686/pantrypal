# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Credentials never go here: use `aws configure`, AWS_PROFILE or SSO.
aws_region          = "ap-south-1"
project             = "pantrypal"
environment         = "dev"
vpc_cidr            = "10.30.0.0/16"
public_subnets      = ["10.30.0.0/20", "10.30.16.0/20"]
private_subnets     = ["10.30.128.0/20", "10.30.144.0/20"]
kubernetes_version  = "1.31"
node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3
